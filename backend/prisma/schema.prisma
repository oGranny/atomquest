// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum GoalSheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
}

enum UoMType {
  NUMERIC
  PERCENTAGE
  TIMELINE
  ZERO_BASED
}

enum CheckInStatus {
  NOT_STARTED
  ON_TRACK
  COMPLETED
}
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      Role     @default(EMPLOYEE)
  department String?
  managerId String?
  manager   User?    @relation("ManagerToSubordinates", fields: [managerId], references: [id])
  subordinates User[] @relation("ManagerToSubordinates")

  goalSheets GoalSheet[]
  auditLogs  AuditLog[]
}

model GoalSheet {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  status          GoalSheetStatus @default(DRAFT)
  cycleYear       Int
  revisionComment String?
  goals           Goal[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

enum GoalDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
}

model Goal {
  id            String    @id @default(cuid())
  goalSheetId   String
  goalSheet     GoalSheet @relation(fields: [goalSheetId], references: [id])
  thrustArea    String
  title         String
  description   String?
  uom           UoMType
  direction     GoalDirection @default(HIGHER_IS_BETTER)
  target        Float
  weightage     Float
  deadline      DateTime?
  isShared      Boolean   @default(false)
  parentGoalId  String?
  parentGoal    Goal?     @relation("SharedGoals", fields: [parentGoalId], references: [id])
  childGoals    Goal[]    @relation("SharedGoals")
  
  checkIns      CheckIn[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model CheckIn {
  id                String        @id @default(cuid())
  goalId            String
  goal              Goal          @relation(fields: [goalId], references: [id])
  quarter           String        // Q1, Q2, Q3, Q4
  actualAchievement Float?
  achievementDate   DateTime?
  status            CheckInStatus @default(NOT_STARTED)
  managerComment    String?
  employeeComment   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  entityId   String
  entityType String
  timestamp  DateTime @default(now())
  details    String?
}